# Copy to .env next to docker-compose.yml. Never commit .env.
# Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
ADMIN_TOKEN=

# Optional
PUBLIC_BASE_URL=https://jmplnk.uk
